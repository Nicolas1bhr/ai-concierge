root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.{py,yaml,yml,json}]
indent_style = space
indent_size = 4

[*.{yaml,yml,json}]
indent_size = 2

# Pinned documents are byte-exact (PINS.yaml); editors must not touch them.
[{canon,foundation,program,design}/**]
insert_final_newline = unset
trim_trailing_whitespace = unset
